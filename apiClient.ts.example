/**
 * Ejemplos de uso del apiClient
 * ─────────────────────────────
 * Este archivo es solo referencia — no forma parte del build.
 */

import { apiClient, setForbiddenHandler, ApiError } from "../lib/apiClient";

// ── 1. Registrar el handler de 403 (hacer esto en layout.tsx o _app) ─────────
//
// Cuando el equipo integre un sistema de notificaciones (toast, modal, etc.)
// solo hay que reemplazar el console.warn por la llamada correspondiente.
//
// setForbiddenHandler((message) => {
//   toast.error(message);        // con react-hot-toast, por ejemplo
//   showModal({ body: message }); // o con el componente Modal del proyecto
// });
//
// Mientras tanto, el error 403 simplemente se propaga como excepción
// y cada componente puede capturarlo con try/catch.

// ── 2. GET — listar publicaciones ─────────────────────────────────────────────

interface Publicacion {
  id_publicacion: number;
  titulo: string;
  descripcion: string;
  precio: number;
}

async function obtenerPublicaciones(): Promise<Publicacion[]> {
  return apiClient.get<Publicacion[]>("/api/publicaciones");
}

// ── 3. POST — crear publicación ───────────────────────────────────────────────

async function crearPublicacion(data: Omit<Publicacion, "id_publicacion">) {
  return apiClient.post<Publicacion>("/api/publicaciones", data);
}

// ── 4. PUT — actualizar perfil ────────────────────────────────────────────────

async function actualizarPerfil(data: { nombre?: string; descripcion?: string }) {
  return apiClient.put("/api/usuarios/perfil", data);
}

// ── 5. DELETE — eliminar publicación ──────────────────────────────────────────

async function eliminarPublicacion(id: number) {
  return apiClient.delete(`/api/publicaciones/${id}`);
}

// ── 6. Manejo de errores en un componente ─────────────────────────────────────

async function ejemploConManejoDeError() {
  try {
    const pubs = await obtenerPublicaciones();
    console.log(pubs);
  } catch (error) {
    const apiError = error as ApiError;

    if (apiError.status === 403) {
      // El handler global ya fue llamado si fue registrado.
      // Aquí puedes hacer lógica adicional si lo necesitas.
      console.warn("Sin permisos:", apiError.message);
    } else {
      console.error("Error inesperado:", apiError.message);
    }
  }
}

export { obtenerPublicaciones, crearPublicacion, actualizarPerfil, eliminarPublicacion, ejemploConManejoDeError };
